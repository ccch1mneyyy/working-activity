+/**
+ * Wire-narrowed `activity/status` payload for the client runtime.
+ *
+ * The event type is declared by the host-side @deepseek-ai/dsh-working-activity
+ * plugin whose types cannot enter the client program (its host Context merges
+ * collide with the client's), so this wire consumer narrows the payload
+ * structurally — the same posture as every other cross-wire event payload.
+ * @module @deepseek-ai/dsh-client-runtime/activity
+ */
+
+/** The `activity/status` phase vocabulary as seen on the wire. */
+export type ActivityStatusPhase = 'idle' | 'waiting' | 'thinking' | 'tool' | 'done'
+
+/** One validated `activity/status` snapshot for UI rendering. */
+export interface ActivityStatusView {
+  readonly phase: ActivityStatusPhase
+  /** Human-readable status line (plain text, no ANSI). */
+  readonly line: string
+  /** Short label of the current work, when present. */
+  readonly label?: string
+  /** Detail fragment (path / command / pattern), when present. */
+  readonly detail?: string
+  /** The playful phrase currently shown, when present. */
+  readonly phrase?: string
+  /** Tools completed in the current turn. */
+  readonly toolCount: number
+  /** Milliseconds since the current turn started. */
+  readonly turnElapsedMs: number
+  /** Wall-clock time (epoch ms) the current phase started, for animations. */
+  readonly phaseStartedAt: number
+}
+
+const PHASES: ReadonlySet<string> = new Set(['idle', 'waiting', 'thinking', 'tool', 'done'])
+
+/**
+ * Validate a wire `activity/status` payload structurally.
+ * @param data - The raw event data.
+ * @returns The narrowed view, or `null` when malformed.
+ */
+export function parseActivityStatusData(data: unknown): ActivityStatusView | null {
+  if (data === null || typeof data !== 'object' || Array.isArray(data)) return null
+  const record = data as Record<string, unknown>
+  if (typeof record.phase !== 'string' || !PHASES.has(record.phase)) return null
+  if (typeof record.line !== 'string' || record.line.length === 0) return null
+  for (const key of ['toolCount', 'turnElapsedMs', 'phaseStartedAt']) {
+    const value = record[key]
+    if (typeof value !== 'number' || !Number.isFinite(value) || value < 0) return null
+  }
+  for (const key of ['label', 'detail', 'phrase']) {
+    if (record[key] !== undefined && typeof record[key] !== 'string') return null
+  }
+  const view: ActivityStatusView = {
+    phase: record.phase as ActivityStatusPhase,
+    line: record.line,
+    toolCount: record.toolCount as number,
+    turnElapsedMs: record.turnElapsedMs as number,
+    phaseStartedAt: record.phaseStartedAt as number,
+    ...(record.label === undefined ? {} : { label: record.label as string }),
+    ...(record.detail === undefined ? {} : { detail: record.detail as string }),
+    ...(record.phrase === undefined ? {} : { phrase: record.phrase as string }),
+  }
+  return view
+}

+// Working-line dock entry: renders the turn-end statistics summary (the
+// working-activity plugin's done snapshot) above the composer. Live phases are
+// shown by the chat TurnStatus label, so this dock entry stays hidden while a
+// turn runs and appears only after it settles.
+//
+// The 'conversation.input.dock' SlotMap declaration lives in
+// ../contract/slots.ts beside the other input-region slots.
+import type { Context } from 'cordis'
+import type { PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import { NS } from '../locales.ts'
+import css from './WorkingLine.module.css'
+
+/** Full props of the dock entry: the input-zone runtime share + the locale seat. */
+export type WorkingLineProps = PropsRuntime<'conversation.input.dock'> & PropsLocale<'conversation'>
+
+/**
+ * Turn-summary line: one dim row with a steady marker, rendered only after a
+ * turn settles (the done summary), hidden during live phases and idle.
+ */
+export function WorkingLine({ useSession }: WorkingLineProps) {
+  const activity = useSession(s => s.activity)
+  if (activity === null || activity.phase !== 'done' || activity.line === '') return null
+  return (
+    <div className={css.line} data-activity-phase={activity.phase}>
+      <span className={css.marker} aria-hidden="true" />
+      <span className={css.text}>{activity.line}</span>
+    </div>
+  )
+}
+
+export const workingLineEntry = {
+  name: 'conversation-working-line',
+  inject: ['slots'],
+  /**
+   * Register the working line as the first input-dock entry (order 10, before
+   * the queue strip at 20).
+   * @param ctx - registrant context (disposal rides ctx.effect inside slots.register).
+   */
+  apply(ctx: Context): void {
+    ctx.slots.register({
+      name: 'conversation.input.dock',
+      id: 'activity',
+      order: 10,
+      locale: NS,
+    }, WorkingLine)
+  },
+}

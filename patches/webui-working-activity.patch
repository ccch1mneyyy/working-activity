+// @vitest-environment jsdom
+// WorkingLine (conversation.input.dock entry): renders the latest
+// activity/status snapshot, hides while idle/absent, and updates live.
+
+import { afterEach, describe, expect, it } from 'vitest'
+import { act, cleanup, render } from '@testing-library/react'
+import type {
+  ActivityStatusView, ConversationSnapshot, SessionId,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import { bindSnapshotSelector } from '@deepseek-ai/dsh-client-web-react'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import { WorkingLine, type WorkingLineProps } from '../src/client/chat/WorkingLine.tsx'
+import { zh } from '../src/client/locales.ts'
+
+const t: WorkingLineProps['t'] = makeTranslate(zh, commonZh)
+
+afterEach(cleanup)
+
+const SID = 's1' as SessionId
+
+const TOOL: ActivityStatusView = {
+  phase: 'tool',
+  line: '跑个命令 npm test · 12s',
+  label: '跑个命令',
+  detail: 'npm test',
+  toolCount: 1,
+  turnElapsedMs: 12_000,
+  phaseStartedAt: 1_700_000_000_000,
+}
+
+const THINKING: ActivityStatusView = {
+  phase: 'thinking',
+  line: '嗯…让我捋捋 · 总1m23s',
+  phrase: '嗯…让我捋捋',
+  toolCount: 0,
+  turnElapsedMs: 83_000,
+  phaseStartedAt: 1_700_000_000_000,
+}
+
+const DONE: ActivityStatusView = {
+  phase: 'done',
+  line: '搞定 ✓ · 3 工具 · 想12s 干11s',
+  toolCount: 3,
+  turnElapsedMs: 25_000,
+  phaseStartedAt: 1_700_000_000_000,
+}
+
+function snapshotBase(activity: ActivityStatusView | null): ConversationSnapshot {
+  return {
+    sessionId: SID, nodes: [], turnEnds: new Map(), partial: null, runningCalls: [], codeDispatches: new Map(),
+    pending: [], queue: [], running: false, composerPhase: 'active', removed: false, openState: 'open', openError: null,
+    hasMore: false, loadingOlder: false, promptError: null, blank: false, subagent: null, lastAgentError: null,
+    activity,
+  }
+}
+
+function makeSource(init: ConversationSnapshot) {
+  let snap = init
+  const subs = new Set<() => void>()
+  return {
+    set: (next: ConversationSnapshot) => {
+      snap = next
+      for (const fn of [...subs]) fn()
+    },
+    source: {
+      getSnapshot: () => snap,
+      subscribe: (fn: () => void) => {
+        subs.add(fn)
+        return () => subs.delete(fn)
+      },
+    },
+  }
+}
+
+function renderLine(activity: ActivityStatusView | null) {
+  const source = makeSource(snapshotBase(activity))
+  const useSession = bindSnapshotSelector(source.source)
+  return {
+    ...render(<WorkingLine {...kitFor()} useSession={useSession} />),
+    source,
+  }
+}
+
+/** Input-zone owner share plus the framework seats; mirrors queue-dock.spec. */
+function kitFor() {
+  return {
+    sessionId: SID,
+    t,
+    useSessions: (() => { throw new Error('unused') }) as never,
+    useWorkspaces: (() => { throw new Error('unused') }) as never,
+    useProjection: (() => undefined) as never,
+    session: null as never,
+    input: null as never,
+    useInput: (() => { throw new Error('unused') }) as never,
+    inputActions: { setDraft: () => {}, submit: () => {} } as never,
+  }
+}
+
+describe('WorkingLine', () => {
+  it('renders nothing before the first status publish', () => {
+    const { container } = renderLine(null)
+    expect(container.textContent).toBe('')
+  })
+
+  it('hides while idle', () => {
+    const { container } = renderLine({ ...DONE, phase: 'idle', line: '' })
+    expect(container.textContent).toBe('')
+  })
+
+  it('hides during live phases (tool)', () => {
+    const { container } = renderLine(TOOL)
+    expect(container.textContent).toBe('')
+  })
+
+  it('hides during live phases (thinking)', () => {
+    const { container } = renderLine(THINKING)
+    expect(container.textContent).toBe('')
+  })
+
+  it('shows the done summary', () => {
+    const { container } = renderLine(DONE)
+    const line = container.querySelector('[data-activity-phase="done"]')
+    expect(line).not.toBeNull()
+    expect(line!.textContent).toContain('搞定 ✓ · 3 工具')
+  })
+
+  it('appears when a live snapshot settles into done', () => {
+    const { container, source } = renderLine(TOOL)
+    expect(container.textContent).toBe('')
+    act(() => { source.set(snapshotBase(DONE)) })
+    expect(container.querySelector('[data-activity-phase="done"]')).not.toBeNull()
+    expect(container.textContent).toContain('搞定 ✓ · 3 工具')
+  })
+
+  it('clears when the session goes idle', () => {
+    const { container, source } = renderLine(DONE)
+    act(() => { source.set(snapshotBase({ ...DONE, phase: 'idle', line: '' })) })
+    expect(container.textContent).toBe('')
+  })
+})

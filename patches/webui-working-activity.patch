+/**
+ * Activity-status wire handling: payload narrowing plus Session snapshot
+ * integration through the live mux path and history replay.
+ * @module @deepseek-ai/dsh-client-runtime/tests/activity
+ */
+
+import { describe, expect, it } from 'vitest'
+import type { SessionEvent } from '@deepseek-ai/dsh-session/types'
+import type { SessionId } from '@deepseek-ai/dsh-client-connection/client'
+import { Session } from '../src/client/sessions/session.ts'
+import { parseActivityStatusData } from '../src/client/sessions/activity.ts'
+import { FakeApiClient, ok } from './fake-api.ts'
+import { entries } from './event-script.ts'
+
+const SID = 'fk-activity' as SessionId
+
+function activityEvent(seq: number, data: Record<string, unknown>): SessionEvent {
+  return { seq, time: 1_700_000_000_000 + seq, type: 'activity/status', data } as unknown as SessionEvent
+}
+
+const VALID = {
+  phase: 'tool',
+  line: '跑个命令 npm test · 12s',
+  label: '跑个命令',
+  detail: 'npm test',
+  toolCount: 2,
+  turnElapsedMs: 15_000,
+  phaseStartedAt: 1_700_000_000_000,
+}
+
+describe('parseActivityStatusData', () => {
+  it('narrows a valid payload', () => {
+    const view = parseActivityStatusData(VALID)
+    expect(view).not.toBeNull()
+    expect(view).toMatchObject({
+      phase: 'tool',
+      line: '跑个命令 npm test · 12s',
+      detail: 'npm test',
+      toolCount: 2,
+    })
+  })
+
+  it('accepts a payload with optional fields omitted', () => {
+    const view = parseActivityStatusData({
+      phase: 'thinking', line: '嗯…让我捋捋 · 总1m', toolCount: 0, turnElapsedMs: 60_000, phaseStartedAt: 1,
+    })
+    expect(view).not.toBeNull()
+    expect(view?.phrase).toBeUndefined()
+  })
+
+  it('rejects malformed payloads', () => {
+    expect(parseActivityStatusData(null)).toBeNull()
+    expect(parseActivityStatusData('nope')).toBeNull()
+    expect(parseActivityStatusData({ ...VALID, phase: 'dancing' })).toBeNull()
+    expect(parseActivityStatusData({ ...VALID, line: '' })).toBeNull()
+    expect(parseActivityStatusData({ ...VALID, toolCount: -1 })).toBeNull()
+    expect(parseActivityStatusData({ ...VALID, toolCount: Number.NaN })).toBeNull()
+    expect(parseActivityStatusData({ ...VALID, label: 42 })).toBeNull()
+  })
+})
+
+describe('Session activity snapshot', () => {
+  async function opened(history: SessionEvent[]): Promise<Session> {
+    const api = new FakeApiClient()
+    api.onHistory = () => Promise.resolve(ok({ events: entries(history) as never[], hasMore: false }))
+    const session = new Session(SID, api)
+    await session.open()
+    return session
+  }
+
+  it('publishes the latest live activity/status frame', async () => {
+    const session = await opened([])
+    expect(session.getSnapshot().activity).toBeNull()
+    session.handleMuxEnvelope('r1' as never, { type: 'session/event', sessionId: SID, event: activityEvent(0, VALID) })
+    await Promise.resolve()
+    expect(session.getSnapshot().activity).toMatchObject({ phase: 'tool', line: '跑个命令 npm test · 12s' })
+  })
+
+  it('updates on later frames and keeps the reference stable otherwise', async () => {
+    const session = await opened([])
+    session.handleMuxEnvelope('r1' as never, { type: 'session/event', sessionId: SID, event: activityEvent(0, VALID) })
+    await Promise.resolve()
+    const first = session.getSnapshot().activity
+    session.handleMuxEnvelope('r2' as never, {
+      type: 'session/event', sessionId: SID,
+      event: activityEvent(1, { ...VALID, phase: 'done', line: '搞定 ✓ · 2 工具' }),
+    })
+    await Promise.resolve()
+    expect(session.getSnapshot().activity).toMatchObject({ phase: 'done', line: '搞定 ✓ · 2 工具' })
+    expect(session.getSnapshot().activity).not.toBe(first)
+  })
+
+  it('ignores malformed frames without crashing the snapshot', async () => {
+    const session = await opened([])
+    session.handleMuxEnvelope('r1' as never, { type: 'session/event', sessionId: SID, event: activityEvent(0, { ...VALID, phase: 'dancing' }) })
+    await Promise.resolve()
+    expect(session.getSnapshot().activity).toBeNull()
+  })
+
+  it('restores the latest in-window snapshot from history replay', async () => {
+    const session = await opened([
+      activityEvent(0, VALID),
+      activityEvent(1, { ...VALID, phase: 'thinking', line: '嗯…让我捋捋 · 总5s' }),
+    ])
+    expect(session.getSnapshot().activity).toMatchObject({ phase: 'thinking', line: '嗯…让我捋捋 · 总5s' })
+  })
+})
